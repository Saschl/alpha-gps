    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This app needs access to Bluetooth to connect to your cameras and transmit location data for geotagging your photos."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Location permission for background geotagging, including while the phone is locked.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App sendet deine GPS-Koordinaten an die verbundene Kamera, damit deine Fotos automatisch mit Standortdaten versehen werden – auch wenn dein iPhone gesperrt ist. Wähle „Immer“, um dies auch im Hintergrund zu ermöglichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This app uses your location to send GPS coordinates to your connected camera, enabling automatic geotagging of your photos, even when the phone is locked. Select \"Always\" to enable geotagging in the background."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location permission for sending GPS coordinates to the connected camera.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App benötigt fortlaufenden Zugriff auf deinen Standort, um GPS-Koordinaten an die verbundene Kamera zu senden und deine Fotos automatisch mit Standortdaten zu versehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This app needs constant access to location services to send GPS coordinates to your connected camera, enabling automatic geotagging of your photos."
          }
        }
      }
    }
  },
  "version" : "1.2"
